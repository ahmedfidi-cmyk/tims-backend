NODE_ENV=development
PORT=3000

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=lahtha_click_dev

# Logging
LOG_LEVEL=info
SERVICE_NAME=lahtha-click

# IAM — identity & sessions
# OTP codes are stored only as HMAC(code, pepper). Override with a real secret
# outside local dev (the default is intentionally insecure).
IAM_OTP_PEPPER=dev-otp-pepper-change-me

# Microsoft Entra ID for MFA step-up (elevated/CLICK actions).
# When unset, MFA step-up fails closed.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_ISSUER=

# Payments (ADR-0007, revised by ADR-0010). Outside production the default
# provider is the dev "stub" adapter, which AUTO-CAPTURES every intent — it
# MUST NEVER be enabled in production. The real provider (moyasar, direct
# card/mada) fails closed until both its API key and webhook secret are set.
# PAYMENT_PROVIDER=stub
# MOYASAR_API_KEY=
# MOYASAR_WEBHOOK_SECRET=

# Object storage for device documents (ADR-0008). Outside production a dev stub
# is used unless S3 is fully configured; in production a stub is REFUSED (the
# seam fails closed). Set all four S3_* below to enable real presigned uploads.
# Set S3_ENDPOINT for S3-compatible stores (MinIO etc.) — switches to path-style.
# STORAGE_DRIVER=s3
# S3_BUCKET=lahtha-device-docs
# S3_REGION=me-central-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_UPLOAD_EXPIRES_SECONDS=900

# Trading — daily Binance signal generator (docs/adr/0011-trading-signal-agent.md).
# Market-data reads are always mainnet/public; no key is needed for signals alone.
# BINANCE_SPOT_BASE_URL=https://api.binance.com
# BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
# BINANCE_REQUEST_TIMEOUT_MS=8000
# TRADING_STARTING_EQUITY_USD_CENTS=500000
# TRADING_TARGET_EQUITY_USD_CENTS=5000000
# TRADING_CANDIDATE_POOL_SIZE=30

# Trading — LIVE EXECUTION (docs/adr/0012-live-binance-execution.md). OFF by
# default (fails closed) — signals still generate with this unset. Enabling
# this lets the trading domain place REAL Binance orders with REAL money.
#
# Before setting BINANCE_EXECUTION_ENABLED=true:
#   1. Create a Binance API key dedicated to this app. NEVER reuse your main key.
#   2. Disable "Enable Withdrawals" on that key — trading permission only. This
#      is the single most important step: even a leaked key can't move funds out.
#   3. If possible, restrict the key to this server's IP address.
#   4. Start on BINANCE_TRADING_ENV=testnet (default) with testnet keys from
#      https://testnet.binance.vision / https://testnet.binancefuture.com — not
#      your real account — until you've confirmed orders place and close correctly.
# BINANCE_EXECUTION_ENABLED=false
# BINANCE_TRADING_ENV=testnet
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BINANCE_SPOT_TESTNET_BASE_URL=https://testnet.binance.vision
# BINANCE_FUTURES_TESTNET_BASE_URL=https://testnet.binancefuture.com
# Required (in addition to the above) to run BINANCE_TRADING_ENV=mainnet — a
# deliberate second step so mainnet can never be reached by a single typo.
# BINANCE_MAINNET_CONFIRM=I_UNDERSTAND_THE_RISK
# Hard per-trade cap in USD, independent of the Kelly-sized allocationPct.
# MAX_TRADE_NOTIONAL_USD=250
